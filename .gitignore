# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local configuration
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db

# IDE/editor state
.idea/
.vscode/

# Runtime data generated by Jarvis
jarvis_localhost/data/**
!jarvis_localhost/data/
!jarvis_localhost/data/.gitkeep
!jarvis_localhost/data/curiosity/
!jarvis_localhost/data/curiosity/.gitkeep
!jarvis_localhost/data/embeddings/
!jarvis_localhost/data/embeddings/.gitkeep
!jarvis_localhost/data/extracted_images/
!jarvis_localhost/data/extracted_images/.gitkeep
!jarvis_localhost/data/models/
!jarvis_localhost/data/models/.gitkeep
!jarvis_localhost/data/projects/
!jarvis_localhost/data/projects/.gitkeep

jarvis_localhost/uploads/**
!jarvis_localhost/uploads/
!jarvis_localhost/uploads/.gitkeep

# Databases, vector stores, checkpoints and local user documents
*.db
*.sqlite
*.sqlite3
*.pt
*.pth
*.onnx
*.npy
*.npz
*.pkl
*.pdf

# Keep documentation PDFs versionable if needed later
!jarvis_localhost/docs/**/*.pdf
