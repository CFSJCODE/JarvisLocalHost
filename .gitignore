# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local configuration
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db

# IDE/editor state
.idea/
.vscode/

# Runtime data generated by Jarvis
data/**
!data/
!data/.gitkeep
!data/curiosity/
!data/curiosity/.gitkeep
!data/embeddings/
!data/embeddings/.gitkeep
!data/extracted_images/
!data/extracted_images/.gitkeep
!data/models/
!data/models/.gitkeep
!data/projects/
!data/projects/.gitkeep

uploads/**
!uploads/
!uploads/.gitkeep

# Databases, vector stores, checkpoints and local user documents
*.db
*.sqlite
*.sqlite3
*.pt
*.pth
*.onnx
*.npy
*.npz
*.pkl
*.pdf

# Keep documentation PDFs versionable if needed later
!docs/**/*.pdf
