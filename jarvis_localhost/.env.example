# J.A.R.V.I.S. LocalHost -- espelho do baseline soberano canônico.
# Mantenha este arquivo idêntico a jarvis_localhost/.env.example e copie um
# deles para <raiz-do-repositorio>\.env. Nunca versione o .env real.

# Runtime soberano: todas as fontes semânticas externas permanecem bloqueadas.
JARVIS_SOVEREIGN_MODE=1
JARVIS_ALLOW_PRETRAINED_OCR=0
JARVIS_ALLOW_EXTERNAL_WEIGHTS=0
JARVIS_ALLOW_MODEL_DOWNLOADS=0
JARVIS_ALLOW_EXTERNAL_APIS=0
JARVIS_ALLOW_RUNTIME_EGRESS=0
JARVIS_ALLOW_SYSTEM_TTS=0

# Resposta extrativa por padrão. Use "rag" somente após validar treino local.
JARVIS_RAG_MODE=strict

# Hardware. "auto" aceita aceleração apenas depois de smoke test e usa CPU se falhar.
JARVIS_COMPUTE_BACKEND=auto
JARVIS_CPU_THREADS=6
JARVIS_INTEROP_THREADS=2
JARVIS_MAX_RAM_GB=16
JARVIS_MAX_GPU_MEMORY_GB=6
JARVIS_DATALOADER_WORKERS=0

# RAM: teto de planejamento; pedido explícito até 24 GiB mantém reserva física.
# GPU compartilhada utiliza a mesma RAM do Windows; os orçamentos não se somam.
# Opções de execução do recuperador, sem alterar pesos ou lote lógico.
# Ative bucketed/1 somente após medir o hardware; a transição fica no checkpoint.
JARVIS_RETRIEVER_PADDING=fixed
JARVIS_RETRIEVER_MIN_BUCKET=32
JARVIS_RETRIEVER_FUSED_PAIRS=0

# O perfil automático deriva os valores abaixo do corpus e aplica caps seguros.
# Descomente somente para uma experiência medida e reproduzível.
# JARVIS_BATCH_SIZE=2
# JARVIS_CONTEXT_LENGTH=256
# JARVIS_GRAD_ACCUMULATION_STEPS=4
# JARVIS_MAX_STEPS=1000

# Sessão/API local e upload de PDF.
JARVIS_LOCAL_SESSION_TTL_SECONDS=28800
JARVIS_MAX_LOCAL_SESSIONS=128
JARVIS_MAX_PDF_BYTES=67108864
JARVIS_PDF_CONCURRENCY=1

# Integrações opcionais ficam desligadas no baseline soberano.
JARVIS_VOICE_ENABLED=0
JARVIS_WAKE_WORD=jarvis
JARVIS_VOICE_RATE=165
JARVIS_VOICE_VOLUME=1.0

JARVIS_CLUSTER_ENABLED=0
JARVIS_CLUSTER_URL=http://127.0.0.1:8080
JARVIS_CLUSTER_TIMEOUT=4
JARVIS_CLUSTER_ALLOW_REMOTE=0
JARVIS_CLUSTER_ALLOWED_PREFIXES=python,py,python.exe
JARVIS_CLUSTER_DEFAULT_TAGS=

# O launcher MCP define este caminho automaticamente. Se iniciar o servidor
# manualmente, aponte para um SQLite privado dentro de data/integrations.
# JARVIS_TEAM_BUS_DB=E:\SoftwareProjects\JarvisLocalHost\jarvis_localhost\data\integrations\team_bus.sqlite
